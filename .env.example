# Auth. "demo" = INSECURE local-only stub (any password accepted). Leave empty in production until a real provider is wired in lib/auth notes.
AUTH_MODE=
ADMIN_EMAILS=admin@example.com
# Payments: comma-separated provider ids implemented in lib/integrations/payments.ts (e.g. mpesa,card,bank)
PAYMENT_PROVIDERS=
PAYMENT_INSTRUCTIONS_BANK=
PAYMENT_INSTRUCTIONS_MPESA=
# Domain registrar & provisioning (implement the interfaces in lib/integrations)
DOMAIN_PROVIDER=
DOMAIN_PROVIDER_API_KEY=
PROVISIONING_PROVIDER=
PROVISIONING_API_URL=
PROVISIONING_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
